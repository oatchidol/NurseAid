# ============================================
# NurseAid Environment Configuration
# ============================================
# คัดลอกไฟลต์้นี่ไปเป็น .env และแกไขค่า
# cp .env.example .env
# ============================================

# --- Server Configuration ---
PORT=3333
NODE_ENV=production
# สร้างด้วย: openssl rand -hex 32 (ต้องเปลี่ยนก่อนใช้งานจริง)
SESSION_SECRET=replace-with-a-random-64-character-secret
INITIAL_ADMIN_USERNAME=admin
# ใช้เฉพาะฐานข้อมูลใหม่ที่ยังไม่มีผู้ใช้ และต้องยาวอย่างน้อย 12 ตัวอักษร
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password
# เว้นว่างเพื่อยอมรับ same-origin ของ request ปัจจุบัน
APP_ORIGIN=

# --- HIS Patient Census Integration ---
# Base URL ต้องชี้ไปยังโฟลเดอร์ที่มี get_patient.php
# production ควรใช้ HTTPS; เว้นว่างไว้เพื่อปิด integration จนกว่าจะได้รับ URL จากผู้ดูแล HIS
OR_PATIENT_API_BASE_URL=
# เปิดเฉพาะเมื่อ HIS ภายในโรงพยาบาลไม่มี HTTPS และการเชื่อมต่ออยู่ในเครือข่ายที่เชื่อถือได้
OR_PATIENT_ALLOW_HTTP=false
# ระยะเวลารอ HIS 1,000-30,000 ms (ค่าอื่นจะถูกจำกัดให้อยู่ในช่วงนี้)
OR_PATIENT_TIMEOUT_MS=10000

# --- PostgreSQL Configuration ---
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=softwatch_iot
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password

# --- InfluxDB Configuration ---
INFLUX_URL=http://host.docker.internal:8086
INFLUX_TOKEN=your-influxdb-admin-token-here
INFLUX_ORG=softsquaregroup
INFLUX_BUCKET=naret2
INFLUX_ADMIN_PASSWORD=replace-with-a-strong-influx-password

# --- LINE Bot Configuration ---
# ใส LINE TOKEN ของคุณ (หากต้องการใช LINE notification)
# หากไมต้องการให ใสเปนคาวาง
LINE_TOKEN=
LINE_GROUP_ID=
LINE_RATE_LIMIT_BACKOFF_SECONDS=900


# NurseAid AI Assistant (OpenAI-compatible HTTPS endpoint)
AI_CHAT_ENABLED=true
AI_BASE_URL=https://sai.softsquaregroup.com/v1
AI_API_KEY=
AI_MODEL=nurseaid:latest
AI_TIMEOUT_MS=60000
AI_MAX_HISTORY_MESSAGES=8
AI_RATE_LIMIT_PER_MINUTE=10
AI_CONVERSATION_MAX_TOKENS=4096


# --- NurseAid AI Assistant (OpenAI-compatible) ---
# ใช้ HTTPS เท่านั้น เพราะ context อาจมีข้อมูลสุขภาพจากหน้า Monitor
#AI_CHAT_ENABLED=true
#AI_BASE_URL=https://nurseaid-ai.softsquaregroup.com/v1
# เว้นว่างได้เมื่อ endpoint ภายในไม่ตรวจ Bearer token
#AI_API_KEY=
#AI_MODEL=medgemma:27b
#AI_TIMEOUT_MS=60000
#AI_MAX_HISTORY_MESSAGES=8
#AI_RATE_LIMIT_PER_MINUTE=10


# --- NurseAid AI Assistant (OpenAI-compatible) ---
# ใช้ HTTPS เท่านั้น เพราะ context อาจมีข้อมูลสุขภาพจากหน้า Monitor
#AI_CHAT_ENABLED=true
#AI_BASE_URL=https://nurseaid-ai.softsquaregroup.com/v1
# เว้นว่างได้เมื่อ endpoint ภายในไม่ตรวจ Bearer token
#AI_API_KEY=
#AI_MODEL=medgemma:27b
#AI_TIMEOUT_MS=60000
#AI_MAX_HISTORY_MESSAGES=8
#AI_RATE_LIMIT_PER_MINUTE=10

# --- Application Settings ---
ALERT_INTERVAL=15000
SYNC_INTERVAL=15000
# รวมคำขอ Dashboard/Alert ที่มาชนกัน เพื่อลด query ซ้ำ โดยไม่เพิ่ม latency เกินรอบ refresh
LIVE_STATUS_CACHE_MS=3000
# หาก InfluxDB ขัดข้อง ให้คงรายการผู้ป่วย (แต่ซ่อนค่าทางคลินิกเก่า) ได้นาน 5 นาที
LIVE_STATUS_FALLBACK_SECONDS=300
INFLUX_QUERY_TIMEOUT_MS=5000
ALERT_ENGINE_INTERVAL_MS=15000
# Live log session แรกอ่านย้อนหลัง 30 นาที (collector จำกัดค่าสูงสุด 24 ชั่วโมง)
NURSEAID_INITIAL_LOG_HISTORY_MINUTES=30

# --- MQTT Configuration ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=nursemon
MQTT_PASSWORD=change-this-password
# Comma-separated topic filters accepted by the ingestion bridge. Keep ble/#
# while existing devices still publish with the legacy topic contract.
MQTT_TOPICS=ble/#
# เขียน MQTT buffer ลง InfluxDB ทุก 3 วินาที เพื่อลด pipeline latency โดยยัง batch write
MQTT_BRIDGE_SAVE_INTERVAL=3
# เปิดเฉพาะเมื่อต้องวิเคราะห์ payload รายค่า เพราะสร้าง log I/O สูง
MQTT_BRIDGE_VERBOSE_LOGS=false
LIVE_VITAL_FRESHNESS_SECONDS=600
LIVE_STATUS_FRESHNESS_SECONDS=180
LIVE_BATTERY_FRESHNESS_SECONDS=1800
LIVE_PRESENCE_FRESHNESS_SECONDS=90
LIVE_HR_FRESHNESS_SECONDS=30

# --- Central Device Heartbeat Agent ---
NURSEAID_CENTRAL_URL=https://nurseaid-central.softsquaregroup.com
NURSEAID_DEVICE_ID=NA-00000001
NURSEAID_HEARTBEAT_INTERVAL=60


# --- Metadata ---
NURSEAID_APP_VERSION=2.17.0
NURSEAID_HOSPITAL_CODE=
NURSEAID_HOSPITAL_NAME=
NURSEAID_WARD_CODE=
NURSEAID_WARD_NAME=
NURSEAID_INSTALL_POINT=
