// Copy to wifi_credentials.h and fill in. That file is gitignored on purpose:
// a ward WiFi password committed once cannot be taken back out of the history.
// Leaving this file absent is fine — the sketch then ships with no default and a
// new board is provisioned through its setup portal instead.
#pragma once
#define WIFI_SSID        "your-ssid-no-spaces"
#define WIFI_PASS        "your-password-no-spaces"
