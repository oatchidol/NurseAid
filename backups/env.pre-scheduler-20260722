# --- Server Configuration ---
PORT=3333
NODE_ENV=production

# --- PostgreSQL Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=softwatch_iot
DB_USER=postgres
DB_PASSWORD=NewSoftTech^2

# --- InfluxDB Configuration ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=my-super-secret-auth-token!
INFLUX_ORG=softsquaregroup
INFLUX_BUCKET=naret2
INFLUX_ADMIN_PASSWORD=admin123

# --- MQTT Configuration ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=nursemon
MQTT_PASSWORD=NewSoft^2

# --- LINE Bot Configuration ---
# ใส LINE TOKEN ของคุณ (หากต้องการใช LINE notification)
# หากไมต้องการให ใสเปนคาวาง
LINE_TOKEN=

# --- Application Settings ---
ALERT_INTERVAL=15000
SYNC_INTERVAL=15000

# --- BLE Gateway / JStyle Settings ---
# เปิด/ปิดการส่งคำสั่งวัดค่าไปยัง JStyle/iStyle ผ่าน FFF6
JSTYLE_ENABLE_MEASURE_COMMANDS=true
# เปิด log packet JStyle ที่ parser ยังไม่รู้จัก เพื่อใช้ debug กับอุปกรณ์จริง
JSTYLE_DEBUG_UNPARSED=false
# อ่าน HR จาก Manufacturer Data ของ JStyle/J2208A Advertisement ขณะสแกน
JSTYLE_PUBLISH_ADVERTISEMENT=true
# เชื่อม GATT เพื่ออ่าน HR, อุณหภูมิ, SpO2 และแบตเตอรี่ให้ครบ
JSTYLE_CONNECT_FOR_GATT=true
# JStyle SpO2: one isolated continuous measurement with warm-up rejection.
SPO2_SENSOR_SETTLE_SECONDS=3
SPO2_WARMUP_SAMPLES=3
SPO2_SAMPLES_REQUIRED=7
SPO2_MIN_INLIERS=5
SPO2_SAMPLE_TOLERANCE=2
SPO2_HR_TOLERANCE=12
LIVE_VITAL_FRESHNESS_SECONDS=180

# Resume BLE scanning after WearOS notify is ready so advertisement-only devices stay live.
BLE_SCAN_DURING_WEAROS=true

# WearOS publishes vitals about once per minute.
WEAROS_NOTIFICATION_INTERVAL=60
# Base timeout for other BLE connections.
DATA_RECEIVE_TIMEOUT=45

