# ============================================
# NurseAid Environment Configuration
# ============================================
# คัดลอกไฟลต์้นี่ไปเป็น .env และแกไขค่า
# cp .env.example .env
# ============================================

# --- Server Configuration ---
PORT=3333
NODE_ENV=production
# สร้างด้วย: openssl rand -hex 32 (ต้องเปลี่ยนก่อนใช้งานจริง)
SESSION_SECRET=replace-with-a-random-64-character-secret
INITIAL_ADMIN_USERNAME=admin
# ใช้เฉพาะฐานข้อมูลใหม่ที่ยังไม่มีผู้ใช้ และต้องยาวอย่างน้อย 12 ตัวอักษร
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password
# เว้นว่างเพื่อยอมรับ same-origin ของ request ปัจจุบัน
APP_ORIGIN=

# --- PostgreSQL Configuration ---
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=softwatch_iot
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password

# --- InfluxDB Configuration ---
INFLUX_URL=http://host.docker.internal:8086
INFLUX_TOKEN=your-influxdb-admin-token-here
INFLUX_ORG=softsquaregroup
INFLUX_BUCKET=naret2
INFLUX_ADMIN_PASSWORD=replace-with-a-strong-influx-password

# --- LINE Bot Configuration ---
# ใส LINE TOKEN ของคุณ (หากต้องการใช LINE notification)
# หากไมต้องการให ใสเปนคาวาง
LINE_TOKEN=
LINE_GROUP_ID=

# --- Application Settings ---
ALERT_INTERVAL=15000
SYNC_INTERVAL=15000
# รวมคำขอ Dashboard/Alert ที่มาชนกัน เพื่อลด query ซ้ำ โดยไม่เพิ่ม latency เกินรอบ refresh
LIVE_STATUS_CACHE_MS=3000
# หาก InfluxDB ขัดข้อง ให้คงรายการผู้ป่วย (แต่ซ่อนค่าทางคลินิกเก่า) ได้นาน 5 นาที
LIVE_STATUS_FALLBACK_SECONDS=300
INFLUX_QUERY_TIMEOUT_MS=5000
ALERT_ENGINE_INTERVAL_MS=15000
# Live log session แรกอ่านย้อนหลัง 30 นาที (collector จำกัดค่าสูงสุด 24 ชั่วโมง)
NURSEAID_INITIAL_LOG_HISTORY_MINUTES=30

# --- MQTT Configuration ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=nursemon
MQTT_PASSWORD=change-this-password
# เขียน MQTT buffer ลง InfluxDB ทุก 3 วินาที เพื่อลด pipeline latency โดยยัง batch write
MQTT_BRIDGE_SAVE_INTERVAL=3
# เปิดเฉพาะเมื่อต้องวิเคราะห์ payload รายค่า เพราะสร้าง log I/O สูง
MQTT_BRIDGE_VERBOSE_LOGS=false

# --- BLE Gateway / JStyle Settings ---
# รุ่น BlueZ มาตรฐานของ Raspberry Pi OS Bookworm ที่ผ่านการทดสอบ
# ต้องอัปเดตค่านี้พร้อมแพ็กเกจ host แบบ controlled upgrade เท่านั้น
BLUEZ_EXPECTED_PACKAGE_VERSION=5.66-1+rpt1+deb12u2
BLUEZ_EXPECTED_UPSTREAM_VERSION=5.66
# เปิด/ปิดการส่งคำสั่งวัดค่าไปยัง JStyle/iStyle ผ่าน FFF6
JSTYLE_ENABLE_MEASURE_COMMANDS=true
# เปิด log packet JStyle ที่ parser ยังไม่รู้จัก เพื่อใช้ debug กับอุปกรณ์จริง
JSTYLE_DEBUG_UNPARSED=false
# เปิดเฉพาะเมื่อต้องวิเคราะห์ค่าทุก notification ใน production ควรเป็น false
JSTYLE_VERBOSE_SENSOR_LOGS=false
# ต้องยืนยันสถานะถอดข้อมือต่อเนื่องหลาย packet ก่อนซ่อนค่าทางคลินิก
JSTYLE_OFF_WRIST_CONFIRMATIONS=2
# status=0 ต้องครบตามจำนวนภายใน window จึงยืนยันว่าไม่สวม จากนั้นหยุดวัด
# และ probe สั้น ๆ ตาม interval เพื่อดูว่ากลับมาสวมหรือยัง
JSTYLE_OFF_WRIST_CONFIRMATION_WINDOW=300
JSTYLE_OFF_WRIST_PROBE_INTERVAL=90
JSTYLE_WEAR_PROBE_TIMEOUT=12
JSTYLE_FIRST_SAMPLE_TIMEOUT=12
# หลัง restart ให้ลองเริ่ม stream ใหม่ใน connection เดิมก่อนตัด session
JSTYLE_FIRST_SAMPLE_RETRIES=2
JSTYLE_FIRST_SAMPLE_RETRY_DELAY=2
# status=0 ช่วงเริ่ม connection มักเป็น optical startup noise ยังไม่นับเป็นถอดข้อมือ
JSTYLE_STARTUP_OFF_WRIST_GRACE=30
JSTYLE_OFF_WRIST_SUSPECT_RETRY=30
# หลายอุปกรณ์บน adapter เดียว: ให้ JStyle ที่เชื่อมยากลองครั้งเดียวต่อรอบ
# แล้วหมุนไปบริการเรือนอื่น พร้อม exponential backoff 15-120 วินาที
BLE_JSTYLE_ATTEMPTS_PER_TURN=1
BLE_RETRY_BACKOFF_BASE=15
BLE_RETRY_BACKOFF_MAX=120
# รีสตาร์ต discovery เมื่อไม่มี connection/measurement และไม่พบ advertisement
BLE_SCANNER_STALE_SECONDS=90
# Docker healthcheck ต้องเห็น controller/data-plane heartbeat ใหม่ภายในช่วงนี้
BLE_HEALTH_MAX_AGE_SECONDS=45
# พิมพ์สถานะรวมที่ไม่มี MAC/ค่าสัญญาณชีพ เพื่อให้ Center มี operational log
BLE_OPERATIONAL_LOG_INTERVAL=60
# Persistent profile: seven JStyle sessions plus one reserved Wear OS link.
BLE_MAX_GATT_CONNECTIONS=8
BLE_RESERVED_WEAROS_SLOTS=1
# Adaptive dual-controller scheduling identifies hardware by stable public MAC,
# not hci0/hci1 (those names can swap after reboot or USB replug).
BLE_DUAL_ADAPTER_MODE=adaptive
BLE_ADAPTER_ADDRESSES=18:69:45:F3:45:77,2C:CF:67:54:42:05
BLE_AFFINITY_LEASE_SECONDS=1800
BLE_AFFINITY_SWITCH_MARGIN=25
BLE_MAX_GATT_CONNECTIONS_PER_ADAPTER=4
BLE_MAX_ACTIVE_MEASUREMENTS_PER_ADAPTER=4
# อ่าน HR จาก Manufacturer Data ของ JStyle/J2208A Advertisement ขณะสแกน
JSTYLE_PUBLISH_ADVERTISEMENT=true
# เชื่อม GATT เพื่ออ่าน HR, อุณหภูมิ, SpO2 และแบตเตอรี่ให้ครบ
JSTYLE_CONNECT_FOR_GATT=true
# Keep an independent notification session for every worn watch. Command writes
# are serialized briefly, but no lock is held while waiting for measurements.
JSTYLE_PERSISTENT_STREAMING=true
JSTYLE_SPO2_RESTART_DELAY=1
# Used only when persistent streaming is disabled.
JSTYLE_CYCLES_PER_CONNECTION=1
JSTYLE_ROTATION_COOLDOWN=5
# JStyle-only SpO2: stop other sensor activity, settle, then measure once.
SPO2_SENSOR_SETTLE_SECONDS=3
SPO2_WARMUP_SAMPLES=3
SPO2_SAMPLES_REQUIRED=7
SPO2_MIN_INLIERS=5
SPO2_SAMPLE_TOLERANCE=2
SPO2_HR_TOLERANCE=12
LIVE_VITAL_FRESHNESS_SECONDS=600
LIVE_STATUS_FRESHNESS_SECONDS=180
LIVE_BATTERY_FRESHNESS_SECONDS=1800
LIVE_PRESENCE_FRESHNESS_SECONDS=90
LIVE_HR_FRESHNESS_SECONDS=30
PHASE_1_DURATION=35
PHASE_1_MIN_DURATION=15
PHASE_1_STABLE_SAMPLES=3
PHASE_1_HR_TOLERANCE=6
PHASE_1_TEMP_TOLERANCE=0.3
PHASE_2_TIMEOUT=45
SPO2_NO_PROGRESS_TIMEOUT=35
WEAROS_RECONNECT_COOLDOWN=60

# Resume BLE scanning after WearOS notify is ready so advertisement-only devices stay live.
BLE_SCAN_DURING_WEAROS=true

# WearOS publishes vitals about once per minute. Its effective watchdog timeout is
# automatically raised to two notification intervals plus one watchdog cycle.
WEAROS_NOTIFICATION_INTERVAL=60
# Base timeout for other BLE connections.
DATA_RECEIVE_TIMEOUT=45
