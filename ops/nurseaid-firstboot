#!/bin/bash
set -euo pipefail
umask 077
PROJECT_DIR=${NURSEAID_PROJECT_DIR:-/root/nurseaid}
STATE_DIR=${NURSEAID_PROVISION_STATE_DIR:-/var/lib/nurseaid-provision}
STATE_FILE="$STATE_DIR/state"
CENTRAL_URL=${NURSEAID_CENTRAL_URL:-https://nurseaid-central.softsquaregroup.com}
log(){ printf '%s %s\n' "$(date -Is)" "$*"; }
fail(){ log "FAILED: $*"; printf 'failed\n' > "$STATE_FILE"; exit 1; }
install -d -o root -g root -m 0700 "$STATE_DIR"
[[ -d "$PROJECT_DIR" ]] || fail "project directory missing"
serial=$(awk -F ': ' 'tolower($1) ~ /^serial/ {gsub(/[[:space:]]/,"",$2); print tolower($2); exit}' /proc/cpuinfo)
[[ "$serial" =~ ^[0-9a-f]{8,}$ ]] || fail "Raspberry Pi serial unavailable"
suffix=${serial: -8}
desired_hostname="nurseaid-${suffix,,}"
ssh-keygen -A >/dev/null 2>&1 || fail "SSH host key generation failed"
if [[ $(hostname) != "$desired_hostname" ]]; then hostnamectl set-hostname "$desired_hostname"; fi
if [[ -f "$STATE_FILE" ]] && grep -qx complete "$STATE_FILE"; then
  systemctl is-active --quiet docker.service || systemctl start docker.service
  exit 0
fi
printf 'waiting-network\n' > "$STATE_FILE"
for _ in $(seq 1 120); do curl -fsS --max-time 10 "$CENTRAL_URL/health" >/dev/null 2>&1 && break; sleep 5; done
curl -fsS --max-time 10 "$CENTRAL_URL/health" >/dev/null || fail "Central unavailable"
if [[ ! -f "$PROJECT_DIR/.env" ]]; then
  [[ -f "$PROJECT_DIR/.env.example" ]] || fail ".env.example missing"
  session=$(openssl rand -hex 32); db=$(openssl rand -base64 32 | tr -d '\n'); influx=$(openssl rand -hex 32); influxpw=$(openssl rand -base64 32 | tr -d '\n'); mqtt=$(openssl rand -base64 24 | tr -d '\n'); admin=$(openssl rand -base64 18 | tr -d '\n')
  printf '%s\n' "$admin" > "$STATE_DIR/local-admin-password"
  chmod 0600 "$STATE_DIR/local-admin-password"
  sed -e "s|replace-with-a-random-64-character-secret|$session|" \
      -e "s|replace-with-a-strong-initial-password|$admin|" \
      -e "s|replace-with-a-strong-database-password|$db|" \
      -e "s|your-influxdb-admin-token-here|$influx|" \
      -e "s|replace-with-a-strong-influx-password|$influxpw|" \
      -e "s|change-this-password|$mqtt|" "$PROJECT_DIR/.env.example" > "$PROJECT_DIR/.env.tmp"
  install -o root -g root -m 0600 "$PROJECT_DIR/.env.tmp" "$PROJECT_DIR/.env"
  rm -f "$PROJECT_DIR/.env.tmp"
fi
chmod 0600 "$PROJECT_DIR/.env"
install -o root -g root -m 0750 "$PROJECT_DIR/ops/nurseaid-compose-collector.py" /usr/local/sbin/nurseaid-compose-collector
install -o root -g root -m 0644 "$PROJECT_DIR/ops/nurseaid-compose-collector.service" /etc/systemd/system/nurseaid-compose-collector.service
install -o root -g root -m 0644 "$PROJECT_DIR/ops/nurseaid-compose-collector.timer" /etc/systemd/system/nurseaid-compose-collector.timer
systemctl daemon-reload
systemctl enable --now docker.service nurseaid-compose-collector.timer
systemctl start nurseaid-compose-collector.service
printf 'starting-compose\n' > "$STATE_FILE"
cd "$PROJECT_DIR"
docker compose config --quiet
docker compose up -d --build
printf 'waiting-services\n' > "$STATE_FILE"
for _ in $(seq 1 180); do
  credential=/var/lib/docker/volumes/nurseaid_device_agent_data/_data/credential.json
  running=$(docker compose ps --status running --services 2>/dev/null | wc -l)
  healthy=$(docker compose ps --format json 2>/dev/null | grep -c '"Health":"healthy"' || true)
  [[ -s "$credential" && "$running" -eq 7 && "$healthy" -eq 7 ]] && { printf 'complete\n' > "$STATE_FILE"; log "Provisioning complete"; exit 0; }
  sleep 5
done
fail "services did not become healthy in time"
