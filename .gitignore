node_modules/
__pycache__/
.pytest_cache/
*.pyc
.env
.docker-compose.yml.swp
test_output.log
*.bak-*

# AI tooling / assistant internals — never belongs in this repo, including
# agent-tooling skills (.claude/skills/) — useful locally for driving/testing
# the app with an agent, but not part of the deployable app itself, so kept
# out of the repo that ships to a new machine.
.claude/
.codex/
.agents/

# Never commit this or anything like it: a machine-local wrapper/installer
# that routes Claude Code work through an unverified external gateway with
# an embedded credential. Not part of the app, not something any clone of
# this repo should carry.
claude.sh
claude-9arm
claude-chidol

# TLS private key + cert are generated per-machine by scripts/generate-certs.sh
# (see DEPLOY.md) — never shared across machines, never committed.
nginx/certs/

# deploy-run scratch (logs, pids, ad-hoc backups)
.compose-ui-deploy/
.compose-monitor-deploy/

# not part of the deployable server app — kept locally, untracked
android-app/
pi-files/
README-Pi5.md
test_monitor_ai_chat.js
test_wards_mgmt.js
test_mqtt_bridge.py
eval_monitor_ai.js
pytest.ini

# machine-local docker-compose override (see Apply Update docs) — never
# committed; the update pipeline's clean-tree guard treats any untracked
# file as a local change and refuses to update, so this must stay ignored
docker-compose.override.yml

.serena/
nul

# Local skill tooling lockfile — machine-specific, not part of the deployable app.
skills-lock.json

# Machine-local MCP server config for agent tooling (host paths + local
# credentials) — not part of the deployable app, never committed.
.mcp.json

# Third-party agent skill tooling (github.com/wedsamuel1230/arduino-skills),
# unpacked in place for firmware work. Machine-local dev tooling, not part of
# the deployable app — same rule as skills-lock.json above. These MUST stay
# ignored: the Apply Update pipeline's clean-tree guard treats any untracked
# file as a local change and refuses to update.
/skills-main/
/firmware/.claude-plugin/
/firmware/.codex-plugin/
/firmware/.cursor-plugin/
/firmware/.cursor/
/firmware/.github/
/firmware/.gitignore
/firmware/docs/
/firmware/evals/
/firmware/references/
/firmware/scripts/
/firmware/skills/
/firmware/tests/
/firmware/AGENTS.md
/firmware/CHANGELOG.md
/firmware/CLAUDE.md
/firmware/CONTRIBUTING.md
/firmware/DEVELOPMENT.md
/firmware/GEMINI.md
/firmware/LICENSE
/firmware/README.md
/firmware/arduino-skills.md
/firmware/plugin.json

# Locally built ESP32 firmware images - build artefacts, not source.
nurseaid_esp32_*.bin

