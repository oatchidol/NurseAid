node_modules/
__pycache__/
.pytest_cache/
*.pyc
.env
.docker-compose.yml.swp
test_output.log

# AI tooling / assistant internals — never belongs in this repo
# (exception: .claude/skills/ — versioned, non-secret skill definitions
# that are meant to travel with the repo; everything else under .claude/
# — credentials, session logs, plugin cache, worktrees — stays ignored.
# Git can't re-include a path whose parent dir is excluded, so this has
# to be "ignore each child of .claude/ individually" (.claude/*) rather
# than "ignore .claude/" — a plain !.claude/skills/ negation after a
# .claude/ directory-exclude is silently a no-op.)
.claude/*
.codex/
.agents/
!.claude/skills

# deploy-run scratch (logs, pids, ad-hoc backups)
.compose-ui-deploy/
.compose-monitor-deploy/

# not part of the deployable server app — kept locally, untracked
android-app/
pi-files/
README-Pi5.md
test_monitor_ai_chat.js
test_wards_mgmt.js
test_mqtt_bridge.py
eval_monitor_ai.js
pytest.ini
